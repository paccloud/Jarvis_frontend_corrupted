# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=your_assistant_id_here

# N8N Configuration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Server Configuration
PORT=5000
REALTIME_PORT=5051
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Workflow Endpoints (relative to N8N_BASE_URL)
# These correspond to the webhook URLs in your n8n workflows:
# - financial-agent: /webhook/financial-agent
# - task-organizer: /webhook/task-organizer
# - email-assistant: /webhook/email-assistant
# - receipt-sorter: /webhook/receipt-sorter
# - general-assistant: /webhook/general-assistant
